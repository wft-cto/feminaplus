<section class="py-16 bg-black">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2
      class="text-[44px] font-anticdidone text-center font-normal text-white mb-8"
    >
      #feminaplus44 on instagram
    </h2>
    <div class="instagram-slider">
      <div class="border rounded-[20px] overflow-hidden border-[#4c4c4c]">
        <Image class="w-full" src={userOne} alt={`${userOne}`} />
        <div class="bg-black px-[9px] pt-[14px] pb-[20px]">
          <p class="text-white font-manropefont-medium text-[14px]">
            Hair stylists at JUICE believe that beauty is different for every
            person.
          </p>
          <div
            class="text-[#13D2EB] flex items-center gap-[9px] text-[14px] font-manrope"
          >
            <span>#hairstyle</span>
            <span>#fashion</span>
          </div>
          <div
            class="flex
          items-center
              mt-[15px]
          justify-between"
          >
            <div class="flex items-center gap-[10px]">
              <div
