<style>
  .slick-slide {
    margin: 0 8px;
  }

  .slick-slide:not(.slick-active) {
    opacity: 0.5;
    transition: opacity 0.5s ease-in-out;
  }

  .slick-slide.slick-current {
    opacity: 1;
    transition: opacity 0.5s ease-in-out;
  }
</style>
<script is:inline>
  $(".instagram-slider").slick({
    centerMode: true,
    slidesToScroll: 1,
    autoplay: true,
    prevArrow:
      '<button class="slick-prev slick-arrow"><span class="customArrow">←</span></button>',
    nextArrow:
      '<button class="slick-next slick-arrow"><span class="customArrow">→</span></button>',
    autoplaySpeed: 3000,
    centerPadding: "60px",
    slidesToShow: 3,
    responsive: [
      {
        breakpoint: 1110,
        settings: {
          arrows: true,
          centerPadding: "40px",
          centerMode: true,
          slidesToShow: 2,
        },
      },
      {
        breakpoint: 590,
        settings: {
          arrows: true,
          centerPadding: "40px",
          centerMode: true,
          slidesToShow: 1,
        },
      },
    ],
  });
</script>
