---

<section id="media" class="py-16 bg-black">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2
      data-aos="flip-down"
      data-aos-duration="400"
      data-aos-delay="400"
      class="text-[44px] font-anticdidone text-center font-normal text-white mb-8"
    >
      #feminaplus on instagram
    </h2>
    <div
      data-aos="fade-in"
      data-aos-duration="400"
      data-aos-delay="400"
      class="instagram-slider"
    >
      {
        instagramPosts.map((posts) => (
          <a href={posts.permalink} target="_blank" rel="noopener noreferrer">
          <div class="border rounded-[20px] overflow-hidden border-[#4c4c4c]">
            <Image
              class="w-full h-[480px] object-cover object-top"
              src={posts.media_url}
              alt={`${posts.media_url}`}
            />
            <div class="bg-black px-[9px] pt-[14px] pb-[20px]">
              <p class="text-white font-manropefont-medium text-[14px]">
                {posts.caption}
              </p>
              <div class="text-[#13D2EB] flex items-center gap-[9px] text-[14px] font-manrope">
                <span>#hairstyle</span>
                <span>#fashion</span>
              </div>
              <div
                class="flex
          items-center
              mt-[15px]
          justify-between"
              >
                <div class="flex items-center gap-[10px]">
                  <div class="w-[47px] h-[47px] bg-white flex justify-center items-center rounded-[50px]">
                    <Image src={Logo} alt={`${Logo}`} />
                  </div>
                  <div>
                    <p class="font-manrope text-white font-bold text-[16px] text-whites">
                      Familnaplus
                    </p>
                    <div class="flex items-start md:items-center flex-col md:flex-row gap-[9px]">
                      <p class="font-manrope opacity-[70%] font-medium text-[14px] text-white">
                        @famina
                      </p>
                      <ul class="list-disc pl-[9px]">
                        <li class="font-manrope opacity-[70%] font-medium text-[14px] text-white">
                          2 hours ago
                        </li>
                      </ul>
                    </div>
                  </div>
                </div>
                <div>
                  <Image src={instagram} alt={`${instagram}`} />
                </div>
              </div>
            </div>
          </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .slick-slide {
    margin: 0 8px;
  }

  .slick-slide:not(.slick-active) {
    opacity: 0.5;
    transition: opacity 0.5s ease-in-out;
  }

  .slick-slide.slick-current {
    opacity: 1;
    transition: opacity 0.5s ease-in-out;
  }
</style>
<script is:inline>
  $(".instagram-slider").slick({
    centerMode: true,
    slidesToScroll: 1,
    autoplay: true,
    prevArrow:
      '<button class="slick-prev slick-arrow"><span class="customArrow">←</span></button>',
    nextArrow:
      '<button class="slick-next slick-arrow"><span class="customArrow">→</span></button>',
    autoplaySpeed: 3000,
    centerPadding: "60px",
    slidesToShow: 3,
    responsive: [
      {
        breakpoint: 1110,
        settings: {
          arrows: true,
          centerPadding: "40px",
          centerMode: true,
          slidesToShow: 2,
        },
      },
      {
        breakpoint: 590,
        settings: {
          arrows: true,
          centerPadding: "00px",
          centerMode: true,
          slidesToShow: 1,
        },
      },
    ],
  });
</script>
