---
interface Props {
  serviceType?: string;
}

const { serviceType } = Astro.props;

// Base business information
const businessSchema = {
  "@context": "https://schema.org",
  "@type": "BeautySalon",
  "name": "Femina Plus",
  "image": "https://feminaplussalon.com/FP-logo.svg",
  "url": "https://feminaplussalon.com",
  "telephone": "+91-XXXXXXXXXX", // Add actual phone number
  "priceRange": "₹₹",
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "IN",
    "addressRegion": "Multiple Locations"
  },
  "geo": {
    "@type": "GeoCoordinates"
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday"
      ],
      "opens": "10:00",
      "closes": "21:00"
    }
  ],
  "sameAs": [
    "https://www.instagram.com/feminaplussalon",
    "https://www.facebook.com/feminaplussalon"
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.8",
    "reviewCount": "500+"
  }
};

// Add service-specific schema
const serviceSchemas: Record<string, any> = {
  makeup: {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Makeup Services",
    "provider": {
      "@type": "BeautySalon",
      "name": "Femina Plus"
    },
    "areaServed": "IN",
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Makeup Services",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Bridal Makeup"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Party Makeup"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Professional Makeup"
          }
        }
      ]
    }
  },
  "hair-color": {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Hair Coloring Services",
    "provider": {
      "@type": "BeautySalon",
      "name": "Femina Plus"
    },
    "areaServed": "IN",
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Hair Color Services",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Full Hair Coloring"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Highlights & Balayage"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Root Touch-up"
          }
        }
      ]
    }
  },
  "hair-patch": {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Hair Patch & Wig Services",
    "provider": {
      "@type": "BeautySalon",
      "name": "Femina Plus"
    },
    "areaServed": "IN",
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Hair Patch & Wig Services",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Hair Patch Installation"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Custom Wig Design"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Wig Maintenance"
          }
        }
      ]
    }
  }
};

// Breadcrumb schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://feminaplussalon.com"
    }
  ]
};

// Add service breadcrumb if service type is specified
if (serviceType) {
  breadcrumbSchema.itemListElement.push({
    "@type": "ListItem",
    "position": 2,
    "name": serviceType === 'makeup' ? 'Makeup Services' :
            serviceType === 'hair-color' ? 'Hair Color Services' :
            serviceType === 'hair-patch' ? 'Hair Patch & Wigs' : serviceType,
    "item": `https://feminaplussalon.com/${serviceType}`
  });
}

// Combine schemas
const schemas = [businessSchema, breadcrumbSchema];
if (serviceType && serviceSchemas[serviceType]) {
  schemas.push(serviceSchemas[serviceType]);
}
---

<!-- Organization & Local Business Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(schemas)} />
