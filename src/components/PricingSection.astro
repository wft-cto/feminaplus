---
interface PricingItem {
  name: string;
  price: string;
  note?: string;
}

interface SubGroup {
  name: string;
  items: PricingItem[];
}

interface WaxingItem {
  name: string;
  honey: string;
  rica: string;
}

interface Props {
  id: string;
  title: string;
  items?: PricingItem[];
  subGroups?: SubGroup[];
  waxingItems?: WaxingItem[];
  dark?: boolean;
  categoryName: string;
}

const { id, title, items, subGroups, waxingItems, dark = false, categoryName } = Astro.props;
const whatsappNumber = "8725055006";
const whatsappMessage = `Hi, I'm interested in your ${categoryName} services. Can you help me book an appointment?`;
---

<section
  id={id}
  data-pricing-section
  class:list={["py-14 md:py-20", dark ? "bg-gray-50" : "bg-white"]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2
      data-aos="fade-up"
      class="text-2xl sm:text-3xl md:text-[42px] md:leading-[1.2] font-anticdidone text-black text-center mb-10 md:mb-14"
    >
      {title}
    </h2>

    {/* Sub-grouped items (Hair Women, Hair Men) */}
    {subGroups && subGroups.map((group, gi) => (
      <div class:list={["mb-10", gi > 0 && "mt-10"]}>
        <div class="border-l-2 border-black pl-3 mb-5">
          <h3 class="text-[11px] uppercase tracking-[0.2em] font-manrope font-semibold text-gray-500">
            {group.name}
          </h3>
        </div>
        <div class="space-y-0">
          {group.items.map(item => (
            <div class="flex items-baseline gap-2 py-[10px] border-b border-gray-100 last:border-0">
              <span class="font-manrope text-[15px] text-gray-800">{item.name}</span>
              <span class="flex-1 border-b border-dotted border-gray-300 min-w-6 translate-y-[-5px]"></span>
              <span class="font-manrope font-semibold text-[15px] text-gray-900 whitespace-nowrap">
                {item.price}
                {item.note && (
                  <span class="text-xs font-normal text-gray-400 ml-1">{item.note}</span>
                )}
              </span>
            </div>
          ))}
        </div>
      </div>
    ))}

    {/* Simple items list */}
    {items && (
      <div class="space-y-0">
        {items.map(item => (
          <div class="flex items-baseline gap-2 py-[10px] border-b border-gray-100 last:border-0">
            <span class="font-manrope text-[15px] text-gray-800">{item.name}</span>
            <span class="flex-1 border-b border-dotted border-gray-300 min-w-6 translate-y-[-5px]"></span>
            <span class="font-manrope font-semibold text-[15px] text-gray-900 whitespace-nowrap">
              {item.price}
              {item.note && (
                <span class="text-xs font-normal text-gray-400 ml-1">{item.note}</span>
              )}
            </span>
          </div>
        ))}
      </div>
    )}

    {/* Waxing table (dual-column pricing) */}
    {waxingItems && (
      <div class="overflow-x-auto -mx-4 px-4">
        <table class="w-full">
          <thead>
            <tr class="border-b-2 border-black">
              <th class="text-left py-3 font-manrope text-[13px] uppercase tracking-wider font-semibold text-gray-900">Service</th>
              <th class="text-right py-3 font-manrope text-[13px] uppercase tracking-wider font-semibold text-gray-900">Honey</th>
              <th class="text-right py-3 font-manrope text-[13px] uppercase tracking-wider font-semibold text-gray-900">Rica</th>
            </tr>
          </thead>
          <tbody>
            {waxingItems.map(item => (
              <tr class="border-b border-gray-100">
                <td class="py-3 font-manrope text-[15px] text-gray-800">{item.name}</td>
                <td class="py-3 text-right font-manrope text-[15px] font-semibold text-gray-900">{item.honey}</td>
                <td class="py-3 text-right font-manrope text-[15px] font-semibold text-gray-900">{item.rica}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    <div class="text-center mt-10">
      <a
        href={`https://wa.me/91${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-[#25D366] hover:bg-[#20BA5A] text-white px-6 py-3 rounded-full transition-colors duration-200 text-sm font-manrope font-semibold"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
        </svg>
        Book {categoryName}
      </a>
    </div>
  </div>
</section>
