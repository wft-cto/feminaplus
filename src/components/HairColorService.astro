          class="inline-flex items-center gap-3 bg-[#25D366] hover:bg-[#20BA5A] text-white px-6 md:px-8 py-3 md:py-4 rounded-full transition-colors duration-200 text-base md:text-lg font-manrope font-semibold shadow-lg hover:shadow-xl"
