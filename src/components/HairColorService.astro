---
import "../css/style.css";

interface HairPatchWigService {
  id: string;
  name: string;
}

const hairPatchWigServices: HairPatchWigService[] = [
  { id: "new-hair-patch", name: "Global Hair Color" },
  { id: "hair-patch-retightening", name: "Highlights & hair streaks" },
  { id: "lace-front-wigs", name: "Balayage & ombre" },
  { id: "full-ladies-wig", name: "Baby-lights" },
  { id: "hair-toppers", name: "Color correction" },
  { id: "customized-wigs", name: "Color retouch/root touch up" },
  { id: "wig-restyling", name: "Color maintenance" },
  { id: "wig-maintenance", name: "Olaplex treatment" },
];

// WhatsApp number - can be updated or made dynamic
const whatsappNumber = "8725055006"; // Default WhatsApp number
---

<section class="py-16 md:py-24 bg-white relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-12 md:mb-16">
      <div
        data-aos="fade-up"
        data-aos-delay="200"
        class="flex gap-[17px] items-center justify-center mb-6"
      >
        <div class="h-[10px] w-[33px] rounded-full bg-black"></div>
        <p class="font-bold text-sm md:text-base">Our Services</p>
      </div>
      <h2
        data-aos="fade-up"
        data-aos-delay="400"
        class="text-[40px] md:text-[54px] leading-[50px] md:leading-[64px] font-anticdidone text-black mb-4"
      >
        Hair Color Services
      </h2>
      <p
        data-aos="fade-up"
        data-aos-delay="600"
        class="text-lg md:text-xl text-gray-600 font-manrope max-w-2xl mx-auto"
      >
        Professional hair colors for every need
      </p>
    </div>

    <!-- Services List -->
    <div class="max-w-4xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 mb-8">
        {hairPatchWigServices.map((service, index) => (
          <div
            data-aos="fade-up"
            data-aos-delay={100 * (index + 1)}
            class="flex items-center justify-between p-4 md:p-6 bg-gray-50 hover:bg-gray-100 rounded-lg transition-colors duration-200 border border-gray-200 hover:border-gray-300"
          >
            <span class="text-lg md:text-xl font-manrope text-black font-medium">
              {service.name}
            </span>
            <button
            type="button"
            data-service= {service.name}
            data-hair-patch-wig="false"
             class="flex items-center gap-2 bg-[#25D366] hover:bg-[#20BA5A] text-white px-4 py-2 rounded-full transition-colors duration-200 text-sm md:text-base font-manrope font-medium whitespace-nowrap"
              onclick="openBookingModal(this)"
          >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
              Book Now
          </button>
          </div>
        ))}
      </div>

      <!-- Quick WhatsApp CTA -->
      <!-- <div
        data-aos="fade-up"
        data-aos-delay="1000"
        class="text-center mt-8 md:mt-12"
      >
        <p class="text-gray-600 font-manrope mb-4 text-base md:text-lg">
          Need help choosing the right hair patch or wig service?
        </p>
        <a
          href={`https://wa.me/91${whatsappNumber}?text=Hi, I need help choosing the right hair patch or wig service. Can you help me?`}
          target="_blank"
