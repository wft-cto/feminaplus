---
import "../css/style.css";
---

<div
  class="relative -z-10 pb-[3.232%]"
  style="background-image: url('https://assets.feminaplussalon.com/public/golden_bar_new.webp'); background-size: cover; background-position: center;"
>
  <div
    class="absolute bottom-0 left-0 w-full z-[9999] bg-no-repeat bg-cover p-0 h-[4vw]"
    style="background-image: url('https://assets.feminaplussalon.com/public/golden-bar-cut-shape.png');"
  >
  </div>

  <div class="px-[60px] pt-[22px] pb-[19px] mb-[55px] lg:mb-[13px]">
    <div class="">
      <div class="flex flex-wrap justify-between items-center gap-8 lg:gap-16">
        <div class="flex items-center gap-2">
          <img
            src="https://assets.feminaplussalon.com/public/star.svg"
            alt="star"
          />
          <p
            class="text-[12px] md:text-[15px] lg:text-[22px] text-white font-manrope"
          >
            4.2 rating at Google
          </p>
        </div>

        <div class="flex items-center gap-2">
          <img
            src="https://assets.feminaplussalon.com/public/medal.svg"
            alt="${medal"
          />
          <p
            class="text-[12px] md:text-[15px] lg:text-[22px] text-white font-manrope"
          >
            Award wining (Best Luxury Salon & Spa) by 92.7 Big FM
          </p>
        </div>

        <div class="flex items-center gap-2">
          <img
            src="https://assets.feminaplussalon.com/public/cup.svg"
            alt="cup"
          />
          <p
            class="text-[12px] md:text-[15px] lg:text-[22px] text-white font-manrope"
          >
            Since 1986 (Chandigarh)
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
