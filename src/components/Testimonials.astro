---
import curve from "../../public/our-customers-shape.png";
import customerSixth from ".../../public/testimonial/testimonial_image_sixth.png";
import customerFifth from ".../../public/testimonial/testimonial_image_fifth.jpeg";
import customerForth from ".../../public/testimonial/testimonial_image_forth.jpeg";
import customerThree from ".../../public/testimonial/testimonial_image_third.jpeg";
import customerOne from "../../public/testimonial/testimonial_image_first.png";
import customerTwo from "../../public/testimonial/testimonial_image_second.jpeg";
import customerOneVideo from "../../public/videos/testimonial_video_first.mp4";
import customerTwoVideo from "../../public/videos/testimonial_video_second.mp4";
import customerThirdVideo from "../../public/videos/testimonial_video_third.mp4";
import customerForthVideo from "../../public/videos/testimonial_video_forth.mp4";
import customerFifthVideo from "../../public/videos/testimonial_video_fifth.mp4";
import customerSixthVideo from "../../public/videos/testimonial_video_sixth.mp4";

import four from "../../public/slider-image-four.png";

const solutions = [
  {
    image: customerOne,
    Video: customerTwoVideo,
    description: "Hair Artist, Mackup",
  },
  {
    name: "Sheela devi",
    image: customerSixth,
    Video: customerOneVideo,
    description: "Hair Artist, Mackup",
  },
  {
    name: "Jasmeet kaur",
    image: customerThree,
    Video: customerThirdVideo,
    description: "Hair Artist, Mackup",
  },
  {
    image: customerForth,
    Video: customerForthVideo,
    description: "Hair Artist, Mackup",
  },
   {
    image: customerFifth,
    Video: customerFifthVideo,
    description: "Hair Artist, Mackup",
  },
   {
    image: customerTwo,
    Video: customerSixthVideo,
    description: "Hair Artist, Mackup",
  },
];
import { Image } from "astro:assets";
---

<section
  data-aos="fade-up"
  data-aos-duration="400"
  data-aos-delay="400"
  data-aos-anchor-placement="top-bottom"
  id="testimonials"
  class="pt-6 md:py-16 relative bg-[#F6F6F6] text-black"
>
  <Image class="absolute w-full top-0 z-[999]" src={curve} alt={`${curve}`} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative md:grid md:grid-cols-10 gap-12 pb-20">
      <div
        class="absolute inset-0 bg-cover bg-center bg-no-repeat opacity-10 z-0"
        style="background-image: url('/gen-health-bg.svg');"
      >
      </div>

      <div class="relative z-10 md:col-span-7 md:mt-[92px]">
        <h2
          class="text-[37px] leading-[50px] md:text-[54px] md:leading-[64px] font-anticdidone"
        >
          What Our Customers <br /> Say About Us
        </h2>
      </div>
    </div>
    <div class="testimonals">
      {
        solutions.map((facility) => (
          <div class="relative slide-item">
         <img 
    class="video-thumb w-full h-full object-cover"
    src={facility.image.src}
    alt={facility.name}
  />

  <!-- VIDEO (hidden by default) -->
  <video
    class="slide-video w-full h-full object-cover hidden absolute left-0 top-0  "
    src={facility.Video}
    muted
    playsinline
  ></video>
  
  
            <div class="absolute bottom-[38px] w-full">
              <div class="w-full flex justify-center items-center pb-[42px]">
               <div class="play-btn absolute bottom-[38px] left-0 right-0 mx-auto w-[81px] h-[52px] bg-white rounded-[50px] flex justify-center items-center cursor-pointer">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="35"
                    height="24"
                    viewBox="0 0 35 24"
                    fill="none"
                  >
                    <path
                      d="M24.8333 8.33333L29.5575 5.49885C31.0115 4.62639 31.7386 4.19017 32.3368 4.24594C32.8584 4.29456 33.3343 4.564 33.6443 4.98627C34 5.47055 34 6.31841 34 8.01415V15.9859C34 17.6815 34 18.5294 33.6443 19.0138C33.3343 19.436 32.8584 19.7055 32.3368 19.7541C31.7386 19.8098 31.0115 19.3737 29.5575 18.5012L24.8333 15.6667M6.86667 23H18.9667C21.0202 23 22.047 23 22.8313 22.6003C23.5212 22.2489 24.0822 21.6879 24.4337 20.998C24.8333 20.2137 24.8333 19.1869 24.8333 17.1333V6.86667C24.8333 4.81315 24.8333 3.78637 24.4337 3.00204C24.0822 2.3121 23.5212 1.75117 22.8313 1.39965C22.047 1 21.0202 1 18.9667 1H6.86667C4.81315 1 3.78637 1 3.00204 1.39965C2.3121 1.75117 1.75117 2.3121 1.39965 3.00204C1 3.78637 1 4.81313 1 6.86667V17.1333C1 19.1869 1 20.2137 1.39965 20.998C1.75117 21.6879 2.3121 22.2489 3.00204 22.6003C3.78637 23 4.81313 23 6.86667 23Z"
                      stroke="black"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </div>
              </div>
              <div>
                <p class="text-[18px] font-medium font-manrope text-white">
                  {facility.description}
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .testimonals .slick-arrow {
    color: white !important;
    background-color: black !important;
  }

  .testimonals .slide-dots {
    width: fit-content !;
  }
  .testimonals .slick-center .slide-img {
    height: 100%;
    width: 100%;
    border-radius: 0px;
    margin: 0;
    margin-top: 0;
    transition: none;
  }
  .slick-slide.slick-active::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: -9px;
    transform: translateX(50%);
    width: 0;
    height: 3px;
    background: black;
    border-radius: 2px;
    opacity: 0;
  }

  .slick-slide.slick-active::after {
    width: 100%;
    opacity: 1;
  }

  .slick-list,
  .draggable {
    padding-block: 30px !important;
  }

  /* .slick-active {
    height: 535px;
  } */

  .testimonals .slide-item {
  position: relative;
  width: 100%;
  height: 535px; /* Fixed height for all slides */
  overflow: hidden;
}

.testimonals .slide-item img,
.testimonals .slide-item video {
  width: 100%;
  height: 100%;
  object-fit: cover; /* Ensures content fills the container without stretching */
  top: 0;
  left: 0;
}
  
</style>
<script is:inline>
  $(".testimonals").slick({
    centerMode: true,
    slidesToScroll: 1,
    autoplay: true,
    prevArrow:
      '<button class="slick-prev slick-arrow"><span class="customArrow">←</span></button>',
    nextArrow:
      '<button class="slick-next slick-arrow"><span class="customArrow">→</span></button>',
    autoplaySpeed: 3000,
    loop: true,
    dots: true,
    centerPadding: "0px",
    slidesToShow: 3,
    responsive: [
      {
        breakpoint: 1110,
        settings: {
          arrows: true,
          centerPadding: "0px",
          centerMode: true,
          slidesToShow: 3,
        },
      },
      {
        breakpoint: 590,
        settings: {
          arrows: true,
          centerPadding: "0px",
          centerMode: true,
          slidesToShow: 1,
        },
      },
    ],
  });

document.addEventListener("DOMContentLoaded", () => {
  const cards = document.querySelectorAll(".slide-item");

  cards.forEach(card => {
    const img = card.querySelector(".video-thumb");
    const video = card.querySelector(".slide-video");
    const playBtn = card.querySelector(".play-btn");

    if (!playBtn || !video) return;

    playBtn.style.cursor = "pointer";

    playBtn.addEventListener("click", (e) => {
      e.stopPropagation();

      if (img) img.classList.add("hidden");
      playBtn.classList.add("hidden");
      video.classList.remove("hidden");
      video.play();
    });

    // **Re-show play button when video ends**
    video.addEventListener("ended", () => {
      video.classList.add("hidden");
      if (img) img.classList.remove("hidden");
      playBtn.classList.remove("hidden");
    });
  });
});

</script>
