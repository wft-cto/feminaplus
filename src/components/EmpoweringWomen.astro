---
import { Image } from "astro:assets";
import demandingIcon from "../../public/demanding_icon.svg";
import marqueLogo from "../../public/marque-logo.svg";

import empowringLogoOne from "../../public/hair_patch.jpeg";
import empowringLogoTwo from "../../public/makeup.jpeg";
import empowringHairColor from "../../public/hair_color.jpeg";
import empowringLogoThree from "../../public/empowering-logo-3.svg";
import empowringLogoFour from "../../public/empowering-logo-4.svg";
import empowringLogoFive from "../../public/empowering-logo-5.svg";
import empowringLogoSix from "../../public/empowering-logo-6.svg";

const mainServices = [
  {
    name: "Hair Patch",
    icon: empowringLogoOne,
    details: [
      "New Hair Patch Installation",
      "Hair patch Re-tightening & Maintenance",
      "Lace Front Hair Wigs",
      "Full ladies hair Wig Installation",
      "Hair Toppers for Ladies",
      "Customized Hair Wigs",
    ],
  },
  {
    name: "Makeup",
    icon: empowringLogoTwo,
    details: [
      "Bridal Make Up",
      "Party Make Up",
      "Engagement Make Up",
      "Photoshoot Make Up",
      "Pre-wedding Make Up",
      "Celebrity Make up",
    ],
  },
  {
    name: "Hair Color",
    icon: empowringHairColor,
    details: [
      "Global Hair Color",
      "Highlights & hair streaks",
      "Balayage & ombre",
      "Baby-lights",
      "Color correction",
      "Color retouch/root touch up",
      "Color maintenance",
      "Olaplex treatment",
    ],
  },
];

const services = [
  {
    name: "Kera Smoothing",
    icon: empowringLogoThree,
    details: [
      "80-90% straight hair results",
      "Smooths frizzy hair",
      "Long-lasting results",
      "Feel wow while touching your hair",
      "Reduces hair styling time",
      "Adds shine & smoothness",
    ],
  },
  {
    name: "Hair Botox",
    icon: empowringLogoFour,
    details: [
      "50-70% straight hair results",
      "Works on chemically treated damaged hair",
      "Reduces frizziness & breakage",
      "Feel wow while touching your hair",
      "Adds elasticity",
      "No formaldehyde or harmful chemicals",
      "Restores hair health & strength",
    ],
  },
  {
    name: "Keratin Treatment",
    icon: empowringLogoFive,
    details: [
      "30-50% straight hair results",
      "Improves hair texture",
      "Feel wow while touching your hair",
      "Eliminates frizziness",
      "Makes hair manageable",
      "Lasts 3-4 months",
      "Adds natural shine",
    ],
  },
  {
    name: "Nano Plastia",
    icon: empowringLogoSix,
    details: [
      "50-70% straight hair results",
      "The most advanced hair treatment at present",
      "Repairs, straightens & strengthens your chemically treated hair",
      "Feel wow while touching your hair",
      "Reduces hair fall",
      "Long-lasting results",
    ],
  },
];

const marqueText = [
  {
    name: "Your Path to Better Health",
  },
  {
    name: "Wellness for Women",
  },
  {
    name: "Shaping Women's Wellness",
  },
];
---

<section id="services" class="pt-16 pb-0 md:py-16 relative bg-white">
  <div
    class="absolute top-2 left-0 w-full pb-[252.69px] z-[9999] bg-no-repeat bg-cover"
    style="background-image: url('/featured-bg.svg');opacity:50%;"
  >
  </div>
  <div
    class="max-w-7xl mx-auto relative z-[9999] overflow-hidden px-4 sm:px-6 pb-[20px] md:pb-[87px] lg:px-8"
  >
    <div class="md:grid md:grid-cols-10 gap-12 mb-[63px]">
      <div data-aos="fade-right" class="md:col-span-7">
        <div class="flex gap-[17px] items-center mb-[28px]">
          <div class="h-[10px] w-[33px] rounded-full bg-black"></div>
          <p>Our featured services</p>
        </div>
        <h2 class="text-5xl md:text-[54px] font-anticdidone text-black mb-6">
          Where Transformation Begins..
        </h2>
      </div>
      <div data-aos="fade-left" class="flex items-center col-span-3">
        <p class="text-[18px] font-manrope text-black">
          Glow all day — beauty made effortless.
        </p>
      </div>
    </div>

    <!-- Service cards -->
    <div
      class="px-[16px] py-[24px] flex flex-col gap-[24px] border-[#D3D3D3] border mb-12 bg-white"
    >
      <div
        class="flex gap-[10px] w-fit transition-all duration-300 shadow-[0_0_0px_0_white] hover:shadow-[0_0_15px_3px_white] rounded-full p-[10px] group-hover:border-none border-[#D9D9D9] border bg-white"
      >
        <Image src={demandingIcon} alt={`${demandingIcon}`} />
        <p class="text-[12px] font-manrope font-bold">Best Demanding</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-4">
        {
          // Render first two services side by side
          mainServices.slice(0, 2).map((service, index) => (
            <div
              data-aos={index % 2 === 0 ? "flip-right" : "flip-left"}
              data-aos-delay="400"
              class="bg-[#F6F6F6] group hover:bg-black group-hover:bg-black group-hover:border-none
          relative border-[#D3D3D3] border w-full p-3 cursor-pointer transition-colors duration-300
          flex flex-col after:bg-black after:absolute after:h-1 after:w-0 after:-bottom-[12px] lg:after:-bottom-[15px] after:left-0 hover:after:w-full after:transition-all after:duration-300"
            >
              <div class="px-[29px] flex lg:mb-9 gap-[78px] items-center min-h-[210px] justify-center flex-wrap md:flex-nowrap md:justify-center lg:justify-normal">
                <div
                  class="relative rounded-full min-w-[135px] w-[135px] h-[183px] bg-white 
            group-hover:bg-[#363636] overflow-hidden flex items-center justify-center"
                >
                  <Image
                    class="absolute -right-[0px] top-0 w-full h-full object-cover"
                    src={service.icon}
                    alt={`${service.icon}`}
                  />
                </div>
                <div>
                  <p class="font-bold text-[20px] sm:text-[32px] min-h-[50px] font-manrope mb-[14px] sm:mb-[26px] group-hover:text-white">
                    {service.name}{" "}
                  </p>
                  <ul class="text-[16px] sm:text-[18px] font-manrope group-hover:marker:text-white group-hover:text-white pl-5 list-disc font-medium">
                    {service.details.map((detail) => (
                      <li>{detail}</li>
                    ))}
                  </ul>
                </div>
              </div>
              <div class="flex absolute md:relative lg:aboslute md:justify-end lg:justify-end md:mt-4 right-5 bottom-4 md:right-1 md:bottom-1 w-full justify-end">
                <div class="border-[#D9D9D9] transition-all duration-300 shadow-[0_0_0px_0_white] hover:shadow-[0_0_15px_3px_white]  bg-white group-hover:bg-black w-fit py-[13px] px-[27px] rounded-full border">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="21px"
                    height="21px"
                    viewBox="0 0 24 24"
                    role="img"
                    class="group-hover:stroke-white"
                    aria-labelledby="arrowRightTopIconTitle"
                    stroke="#000000"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    fill="none"
                    color="#000000"
                  >
                    <title id="arrowRightTopIconTitle">Arrow Right Top</title>
                    <path d="M19 13V5h-8" />
                    <path stroke-linecap="round" d="M19 5l-1 1" />
                    <path d="M18 6L5 19" />
                  </svg>
                </div>
              </div>
            </div>
          ))
        }
        {
          // Render the third service full width in the next row
          mainServices[2] && (
            <div class="md:col-span-2">
              <div
                data-aos={"flip-right"}
                data-aos-delay="400"
                class="bg-[#F6F6F6] group hover:bg-black group-hover:bg-black group-hover:border-none
                relative border-[#D3D3D3] border w-full p-3 cursor-pointer transition-colors duration-300
                flex flex-col after:bg-black after:absolute after:h-1 after:w-0 after:-bottom-[12px] lg:after:-bottom-[15px] after:left-0 hover:after:w-full after:transition-all after:duration-300"
              >
                <div class="px-[29px] flex lg:mb-9 gap-[78px] items-center min-h-[210px] justify-center flex-wrap md:flex-nowrap md:justify-center lg:justify-normal">
                  <div class="relative rounded-full min-w-[135px] w-[135px] bg-white group-hover:bg-[#363636] h-[183px] overflow-hidden">
                    <Image
                      class="absolute -right-[0px] top-0 w-full h-full object-cover"
                      src={mainServices[2].icon}
                      alt={`${mainServices[2].icon}`}
                    />
                  </div>
                  <div>
                    <p class="font-bold text-[20px] sm:text-[32px] min-h-[50px] font-manrope mb-[14px] sm:mb-[26px] group-hover:text-white">
                      {mainServices[2].name}{" "}
                    </p>
                    <ul class="text-[18px] font-manrope group-hover:marker:text-white group-hover:text-white pl-5 list-disc font-medium">
                      {mainServices[2].details.map((detail) => (
                        <li>{detail}</li>
                      ))}
                    </ul>
                  </div>
                </div>
                <div class="flex absolute md:relative lg:aboslute md:justify-end lg:justify-end md:mt-4 right-5 bottom-4 md:right-1 md:bottom-1 w-full justify-end">
                  <div class="border-[#D9D9D9] transition-all duration-300 shadow-[0_0_0px_0_white] hover:shadow-[0_0_15px_3px_white]  bg-white group-hover:bg-black w-fit py-[13px] px-[27px] rounded-full border">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="21px"
                      height="21px"
                      viewBox="0 0 24 24"
                      role="img"
                      class="group-hover:stroke-white"
                      aria-labelledby="arrowRightTopIconTitle"
                      stroke="#000000"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      fill="none"
                      color="#000000"
                    >
                      <title id="arrowRightTopIconTitle">Arrow Right Top</title>
                      <path d="M19 13V5h-8" />
                      <path stroke-linecap="round" d="M19 5l-1 1" />
                      <path d="M18 6L5 19" />
                    </svg>
                  </div>
                </div>
              </div>
            </div>
          )
        }
      </div>
    </div>

    <div class="service-slider">
      {
        services.map((service) => (
          <div
            data-aos="zoom-in"
            class="border relative  group border-[#D3D3D3] hover:bg-black p-6 bg-[#F6F6F6] after:bg-black after:absolute after:h-1 after:w-0 after:-bottom-3 after:left-0 hover:after:w-full after:transition-all after:duration-300 cursor-pointer h-[600px]"
          >
            <div class="w-full text-center flex justify-center">
              <div
                class="rounded-full w-[135px]  h-[183px] bg-white group-hover:bg-[#363636]
                  flex items-center justify-center"
              >
                <Image
                  src={service.icon}
                  alt={`${service.icon}`}
                  class="object-contain max-w-full max-h-full"
                />
              </div>
            </div>

            <div class="w-fit lg:w-[250px] lg:m-auto flex gap-[27px] flex-col min-h-[160px] mt-[6px]">
              <p class="font-bold text-[32px] group-hover:text-white leading-[100%] md:text-[20px] lg:text-[34px] font-manrope min-h[70px]">
                {service.name}
              </p>
              <ul class="marker:text-blackl pl-4 md:text-[12px] lg:text-[16px] group-hover:text-white group-hover:marker:text-white list-disc">
                {service.details.map((detail) => (
                  <li>{detail}</li>
                ))}
              </ul>
            </div>
            <div class="flex absolute md:relative lg:aboslute md:justify-center lg:justify-end md:mt-4 right-5 bottom-4 md:right-1 md:bottom-1 w-full justify-end">
              <div class="border-[#D9D9D9] transition-all duration-300 shadow-[0_0_0px_0_white] hover:shadow-[0_0_15px_3px_white]  bg-white group-hover:bg-black w-fit py-[13px] px-[27px] rounded-full border">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="21px"
                  height="21px"
                  viewBox="0 0 24 24"
                  role="img"
                  class="group-hover:stroke-white"
                  aria-labelledby="arrowRightTopIconTitle"
                  stroke="#000000"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  fill="none"
                  color="#000000"
                >
                  <title id="arrowRightTopIconTitle">Arrow Right Top</title>
                  <path d="M19 13V5h-8" />
                  <path stroke-linecap="round" d="M19 5l-1 1" />
                  <path d="M18 6L5 19" />
                </svg>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
  <marquee
    class="border border-[#D3D3D3] py-2 md:pt-9 md:pb-8 border-r-0 border-l-0"
    direction="left"
  >
    <div class="flex gap-16">
      {
        marqueText.map((marquee) => (
          <div class="flex gap-5">
            <Image src={marqueLogo} alt={`${marqueLogo}`} />
            <p class="text-[34px] ml-[5px] font-anticdidone">{marquee.name}</p>
          </div>
        ))
      }
    </div>
  </marquee>
</section>

<script is:inline>
  $(".service-slider").slick({
    slidesToScroll: 1,
    autoplay: true,
    prevArrow:
      '<button class="slick-prev slick-arrow"><span class="customArrow">←</span></button>',
    nextArrow:
      '<button class="slick-next slick-arrow"><span class="customArrow">→</span></button>',
    autoplaySpeed: 3000,
    centerPadding: "60px",
    slidesToShow: 4,
    infinite: false,
    responsive: [
      {
        breakpoint: 1110,
        settings: {
          arrows: true,
          centerPadding: "40px",
          centerMode: true,
          slidesToShow: 2,
        },
      },
      {
        breakpoint: 590,
        settings: {
          arrows: true,
          centerPadding: "00px",
          centerMode: true,
          slidesToShow: 1,
        },
      },
    ],
  });
</script>
