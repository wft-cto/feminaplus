---
const brands = [
  "https://assets.feminaplussalon.com/public/loreal.png",
  "https://assets.feminaplussalon.com/public/kerastase.png",
  "https://assets.feminaplussalon.com/public/olaplex.png",
  "https://assets.feminaplussalon.com/public/swati.png",
  "https://assets.feminaplussalon.com/public/gk.png",
  "https://assets.feminaplussalon.com/public/ft.jpg",
  "https://assets.feminaplussalon.com/public/mr.jpg",
  "https://assets.feminaplussalon.com/public/dermalogica.png",
];
---

<section class="bg-white">
  <div class="">
    <div
      class="max-w-[1404px] mx-auto grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 lg:grid-cols-6 items-center gap-0"
    >
      {
        brands.map((brand, index) => (
          <div
            data-aos={index % 2 === 0 ? "flip-right" : "flip-left"}
            data-aos-delay={index % 2 === 0 ? "400" : "800"}
            class="border border-[#F6F6F6] py-[12px] md:py-[42px] px-[49px] w-full h-[70px] md:h-[181px] flex items-center justify-center"
          >
            <img src={brand} alt={brand} class="object-contain w-full h-full" />
          </div>
        ))
      }
    </div>
  </div>
</section>
