---
import { Image } from "astro:assets";
import "../css/style.css";
import FloatingWhatsApp from "./FloatingWhatsApp.astro";
---

<section
  class="relative w-full pt-[283px] pb-[163px] bg-gray-900 overflow-hidden"
>
  <!-- Background image -->
  <div
    class="absolute inset-0 bg-cover bg-center"
    style="background-image: url('https://accets.feminaplussalon.com/public/hero_section_image_new.webp'); scale:1.43;"
  >
    <div class="absolute inset-0 bg-black bg-opacity-50"></div>
  </div>

  <!-- Content -->
  <div
    class="relative z-10 h-full flex items-center justify-end px-5 md:pr-8 lg:pr-24 lg:pt-[80px]"
  >
    <div class="text-white max-w-4xl space-y-4">
      <div
        data-aos="fade-left"
        data-aos-delay="400"
        class="flex gap-2 items-center justify-end"
      >
        <p data-aos="fade-left" data-aos-delay="300" class="font-bold">
          Welcome to
        </p>
        <div class="w-[33px] h-[10px] rounded-full bg-white"></div>
      </div>
      <h1
        data-aos="fade-left"
        data-aos-delay="700"
        class="text-[50px] lg:text-[100px] line md:leading-[120px] font-anticdidone text-center lg:text-end"
      >
        The World of Haircare & makeup
      </h1>
      <p
        data-aos="fade-left"
        data-aos-delay="900"
        class="text-xl font-anticdidone uppercase text-center lg:text-end md:text-2xl !mt-7"
      >
        hair | Beauty | Makeup | Hair wigs | Extensions
      </p>
    </div>
  </div>
  <!-- WhatsApp floating button -->
  <FloatingWhatsApp />
</section>
