    address: "SCO 386, SECTOR 8, Panchkula",
    phonenumber: "01724025050",
    phonenumber_display: "0172 4025050",
    whatsappnumber: "9815962884",
    whatsappnumber_display: "9815962884",
  },
  {
    title: "FP ZIRAKPUR",
    location: "Pooja Plazio above Gopal Sweets, Zirakpur - 9872234488",
    image: showroomFive,
    mapEmbed: "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d27462.787987888692!2d76.79353938411842!3d30.638227010429993!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x390f95ae46eb3c4f%3A0xb4ff05585afaa28e!2sFemina%20FLAUNT%20Studio%20Salon%20-%20Bridal%20Makeup%20Salon%20%7C%20Party%20Makeup%20%7C%20Best%20Salon%20%7C%20Best%20Makeup%20Studio%20in%20Zirakpur!5e0!3m2!1sen!2sin!4v1764593216291!5m2!1sen!2sin",
