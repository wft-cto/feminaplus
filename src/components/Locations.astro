                          <svg width="32" height="32" class="h-5 w-5 text-gray-700 p-[1px]" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M32 15.5884C32 24.197 24.967 31.1757 16.2896 31.1757C13.5359 31.1757 10.9491 30.4713 8.6973 29.2379L0 32L2.8351 23.6345C1.40555 21.2867 0.582255 18.5299 0.582255 15.5873C0.583298 6.97871 7.61418 0 16.2916 0C24.9681 0.00208693 32 6.97975 32 15.5884ZM16.2885 2.48554C9.00616 2.48554 3.0824 8.36443 3.0824 15.5915C3.0824 18.4589 4.01735 21.1135 5.5982 23.2735L3.94952 28.1392L9.02286 26.527C11.1098 27.896 13.6068 28.6933 16.2885 28.6933C23.5709 28.6933 29.4967 22.8154 29.4967 15.5884C29.4988 8.36443 23.5719 2.48554 16.2885 2.48554ZM24.223 19.1789C24.125 19.0214 23.8683 18.9254 23.4843 18.7334C23.1013 18.5414 21.2053 17.6179 20.8537 17.4927C20.4989 17.3643 20.2422 17.2996 19.9855 17.6826C19.732 18.0655 18.9932 18.9254 18.7668 19.1821C18.5424 19.4377 18.3181 19.4701 17.933 19.2812C17.548 19.0871 16.3063 18.6864 14.835 17.3852C13.6903 16.371 12.9171 15.1219 12.6938 14.739C12.4673 14.3571 12.6708 14.1505 12.8618 13.9605C13.0339 13.7884 13.2468 13.5139 13.4399 13.2896C13.6329 13.0673 13.6965 12.9098 13.8249 12.6541C13.9512 12.3985 13.8875 12.1762 13.7925 11.9832C13.6965 11.7912 12.9275 9.91294 12.6051 9.14807C12.2847 8.38426 11.9644 8.51052 11.739 8.51052C11.5147 8.51052 11.258 8.47921 11.0013 8.47921C10.7446 8.47921 10.3272 8.57208 9.97554 8.95503C9.6239 9.33799 8.62843 10.2615 8.62843 12.1418C8.62843 14.0242 10.0068 15.8388 10.1999 16.0934C10.394 16.347 12.8649 20.332 16.7789 21.8617C20.6951 23.3904 20.6951 22.8801 21.4005 22.8154C22.1079 22.7507 23.6794 21.8919 23.9987 21.0008C24.3201 20.1055 24.3201 19.3386 24.223 19.1789Z" fill="currentColor"/>
                          </svg>
                          {location.whatsappnumber_display}
                        </a>
                      )}
                    </div>
                  </div>
                </div>
                <div>
                  <a
