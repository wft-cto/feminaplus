---
import { Image } from "astro:assets";
import showroomOne from "../../public/showroom-image-1.jpg";
import showroomTwo from "../../public/showroom-image-2.jpg";
import showroomThree from "../../public/showroom-image-3.jpg";
import showroomFour from "../../public/showroom-image-4.jpg";

interface Location {
  title: string;
  location: string;
  image: any;
  mapEmbed: string;
  address: string;
}

interface Props {
  filterLocations?: string[];
}

const {
  filterLocations,
} = Astro.props;

const allLocations: Location[] = [
  {
    title: "FP44",
    location: "SCO 268, SECTOR 44-C, CHD. - 0172 46228844, 8725055006",
    image: showroomOne,
    mapEmbed: "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3430.1810114964064!2d76.74692179678958!3d30.713311300000004!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x390fec34877564e7%3A0xd275303055eea805!2sFemina%20Plus!5e0!3m2!1sen!2sin!4v1764237095731!5m2!1sen!2sin",
    address: "SCO 268, SECTOR 44-C, Chandigarh"
  },
  {
    title: "FP LUXE",
    location: "SCO 164-165, SECTOR 9-C, CHD. - 0172 4024040, 7973268966",
    image: showroomThree,
    mapEmbed: "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3429.15931549183!2d76.78587599511891!3d30.742026109036036!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x390feda6c8f25a63%3A0xf9705c422afee5a5!2sFemina%20Plus%20Luxe%20Salon%20%7C%20Best%20Salon%20in%20Chandigarh!5e0!3m2!1sen!2sin!4v1764237297051!5m2!1sen!2sin",
    address: "SCO 164-165, SECTOR 9-C, Chandigarh"
  },
  {
    title: "FP KHARAR",
    location: "SCO 55, SECTOR 125, NEW SUNNY ENCLAVE - 9815931884",
    image: showroomFour,
    mapEmbed: "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3430.1234567890!2d76.7890123!3d30.7123456!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMzDCsDQyJzQ0LjQiTiA3NsKwNDcjMjAuNCJF!5e0!3m2!1sen!2sin!4v1234567890123!5m2!1sen!2sin",
    address: "SCO 55, SECTOR 125, NEW SUNNY ENCLAVE"
  },
  {
    title: "FP PKL",
    location: "SCO 386, SECTOR 8 - 0172-4025050, 9815962884",
    image: showroomTwo,
    mapEmbed: "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3430.1234567890!2d76.7890123!3d30.7123456!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMzDCsDQyJzQ0LjQiTiA3NsKwNDcjMjAuNCJF!5e0!3m2!1sen!2sin!4v1234567890123!5m2!1sen!2sin",
    address: "SCO 386, SECTOR 8, Panchkula"
  },
  {
    title: "FP ZIRAKPUR",
    location: "Pooja Plazio above Gopal Sweets, Zirakpur - 9872234488",
    image: showroomTwo,
    mapEmbed: "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3430.1234567890!2d76.7890123!3d30.7123456!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMzDCsDQyJzQ0LjQiTiA3NsKwNDcjMjAuNCJF!5e0!3m2!1sen!2sin!4v1234567890123!5m2!1sen!2sin",
    address: "SCO 386, SECTOR 8, Panchkula"
  },
];

// Filter locations if filterLocations prop is provided
const shopLocaiton = filterLocations 
  ? allLocations.filter(loc => filterLocations.includes(loc.title))
  : allLocations;
---

<section id="locations" class="py-16 bg-white text-black">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative md:grid md:grid-cols-10 gap-12 pb-20">
      <div
        class="absolute inset-0 bg-cover bg-center bg-no-repeat opacity-10 z-0"
        style="background-image: url('/gen-health-bg.svg');"
      >
      </div>

      <div class="relative z-10 md:col-span-7">
        <div
          data-aos="fade-right"
          data-aos-delay="300"
          data-aos-duration="300"
          class="flex gap-[17px] items-center mb-[20px]"
        >
          <div class="h-[10px] w-[33px] rounded-full bg-black"></div>
          <p>Locations</p>
        </div>
        <h2
          data-aos="fade-right"
          data-aos-delay="600"
          data-aos-duration="300"
          class="text-[37px] md:text-[54px] md:leading-[64px] leading-[50px] font-anticdidone"
        >
          Explore Our Convenient <br /> Salon Locations
        </h2>
      </div>

      <div
        data-aos="fade-right"
        data-aos-delay="700"
        data-aos-duration="300"
        class="relative z-10 flex items-center col-span-3"
      >
        <p class="text-[18px] font-manrope text-black">
          Get ready in minutes, glow all day — beauty made effortless.
        </p>
      </div>
    </div>

    <div
      data-aos="fade-in"
      data-aos-delay="1000"
      data-aos-duration="500"
      class="grid gap-6 md:gap-6 lg:gap-0 grid-cols-1 md:grid-cols-2 lg:grid-cols-4"
    >
      {
        shopLocaiton.map((location) => (
          <div class="relative border border-[#D3D3D3] group-hover:border-0 main-inner group after:bg-black after:absolute after:h-1 after:w-0 after:-bottom-[12px] lg:after:-bottom-[8px] after:left-0 hover:after:w-full after:transition-all after:duration-300">
            <div
              class="image_wrapper relative inner transition-all duration-[400ms] ease-in-out
                group-hover:rounded-none "
            >
              <Image
                class="max-w-[229px] w-full max-h-[347px] mx-auto object-cove grayscale rounded-[147px] transition-all duration-[400ms] ease-in-out group-hover:max-w-full group-hover:grayscale-0 group-hover:rounded-none"
                src={location.image}
                alt={`${location.image}`}
              />
            </div>

            <div class="group-hover:bg-black bg-white px-4 pt-[42px] pb-[37px]">
              <p class="text-[32px] leading-[44px] group-hover:text-white text-black font-anticdidone">
                {location.title}
              </p>
              <div class="bg-white group-hover:bg-black flex justify-between text-white group-hover:text-black">
                <p class="group-hover:text-white text-black text-[16px] font-manrope w-[180px]">
                  {location.location}{" "}
                </p>
                <div class="flex justify-center gap-2 flex-col">
                  <div
                    class="border transition-all duration-300
                      shadow-[0_0_0px_0_white]
                      hover:shadow-[0_0_15px_3px_white] border-black group-hover:border-white w-[81px] h-[52px] rounded-[40px] flex items-center justify-center"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="21"
                      height="21"
                      class="fill-black"
                      viewBox="0 0 21 21"
                      fill="none"
                    >
                      <path
                        d="M17.8307 1.06062L1.66825 6.74505C0.756293 7.06579 0.784963 8.36527 1.71018 8.64548L8.82955 10.8016C9.14865 10.8982 9.39859 11.1475 9.49603 11.4664L11.6259 18.4359C11.9089 19.3618 13.211 19.3854 13.5274 18.4705L19.1076 2.33074C19.381 1.53988 18.6201 0.782985 17.8307 1.06062Z"
                        stroke="white"
                        stroke-width="2"
                      />
                    </svg>
                  </div>
                  <p class="text-black group-hover:text-white text-[14px] font-manrope font-medium text-center">
                    Direction
                  </p>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Google Maps Section -->
    <div
      data-aos="fade-up"
      data-aos-delay="1200"
      data-aos-duration="500"
      class="mt-16 md:mt-20"
    >
      <h3
        class="text-2xl md:text-3xl font-anticdidone text-black mb-8 text-center"
      >
        Reach Us
      </h3>
      <div class="space-y-8 md:space-y-12">
        {shopLocaiton.map((location, index) => (
          <div
            data-aos="fade-up"
            data-aos-delay={1400 + index * 100}
            class="bg-white rounded-xl shadow-lg overflow-hidden border border-gray-200"
          >
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-0">
              <!-- Address Details Section -->
              <div class="p-6 md:p-8 lg:p-10 flex flex-col justify-between bg-gray-50 lg:bg-white">
                <div>
                  <h4 class="text-2xl md:text-3xl font-anticdidone text-black mb-4">
                    {location.title}
                  </h4>
                  <div class="space-y-3 mb-6">
                    <p class="text-gray-700 font-manrope text-base md:text-lg">
                      {location.address}
                    </p>
                    <p class="text-gray-600 font-manrope text-sm md:text-base">
                      {location.location.split(" - ")[1] || ""}
                    </p>
                  </div>
                </div>
                <div>
                  <a
                    href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(location.address)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-3 text-black hover:text-gray-700 font-manrope text-base md:text-lg font-medium transition-colors group"
                  >
                    <div class="bg-black group-hover:bg-gray-800 rounded-full p-3 transition-colors">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5 text-white"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                        />
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                        />
                      </svg>
                    </div>
                    Get Directions
                  </a>
                </div>
              </div>
              
              <!-- Google Map Section -->
              <div class="relative w-full h-[300px] md:h-[400px] lg:h-full min-h-[300px]">
                <iframe
                  src={location.mapEmbed}
                  width="100%"
                  height="100%"
                  style="border:0;"
                  allowfullscreen=""
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  class="absolute inset-0 w-full h-full"
                  title={`${location.title} Location Map`}
                ></iframe>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
<style>
  iframe {
    min-height: 300px;
  }
</style>
