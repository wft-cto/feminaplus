        {shopLocaiton.map((location, index) => (
          <div
            data-aos="fade-up"
            data-aos-delay={1000 + index * 100}
            class="bg-white rounded-xl shadow-lg overflow-hidden border border-gray-200"
          >
            <div class="grid grid-cols-1 md:grid-cols-1 lg:grid-cols-3 gap-0 group">
              <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(location.address)}`} class="overflow-hidden">
                <Image
                  class="w-full h-full mx-auto object-cover grayscale transition-all duration-500 ease-in-out group-hover:grayscale-0 group-hover:scale-105 group-hover:rounded-none aspect-[3/2]"
                  src={location.image}
                  alt={`${location.image}`}
                />
              </a>
              <!-- Address Details Section -->
              <div class="p-6 flex flex-col justify-between bg-gray-50 lg:bg-white">
                <div>
                  <h4 class="text-2xl md:text-3xl font-anticdidone text-black mb-4">
                    {location.title}
                  </h4>
                  <div class="space-y-3 mb-6">
                    <div class="flex flex-col gap-[10px]">
                      {location.address && (
                        <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(location.address)}`} target="_blank"  class="flex flex-wrap items-center gap-[8px] text-gray-700 font-manrope text-sm md:text-base hover:opacity-70 transition-opacity duration-200">
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" data-astro-cid-dgfoyax6=""> <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" data-astro-cid-dgfoyax6=""></path> <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" data-astro-cid-dgfoyax6=""></path> </svg>
                          {location.address}
                        </a>
                      )}
                      {location.phonenumber && (
                        <a href={`tel:+91${location.phonenumber}`} target="_blank" class="flex flex-wrap items-center gap-[8px] text-gray-700 font-manrope text-sm md:text-base hover:opacity-70 transition-opacity duration-200">
                          <svg width="27" height="26" class="h-5 w-5 text-gray-700 p-[1px]" viewBox="0 0 27 26" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M4.10449 1.58105C4.9551 0.719146 6.44888 0.80916 7.25391 1.90527L9.14551 4.48145C9.79491 5.36589 9.70083 6.54054 9.00391 7.24707L8.57422 7.68262L9.17285 8.27344C8.59284 7.70153 8.5737 7.68425 8.57227 7.68457L8.55762 7.69922C8.55182 7.70535 8.54559 7.7125 8.53906 7.71973C8.52606 7.73413 8.51158 7.75068 8.49609 7.76953C8.46497 7.8074 8.42917 7.85459 8.3916 7.91113C8.31631 8.02447 8.23347 8.17575 8.16309 8.36621C8.01985 8.75404 7.94034 9.27207 8.03906 9.9209C8.23298 11.1945 9.10101 12.9142 11.3828 15.2275C13.6632 17.5394 15.3636 18.4239 16.6309 18.6221C17.2778 18.7232 17.7956 18.6415 18.1836 18.4941C18.3737 18.4219 18.5241 18.3376 18.6367 18.2607C18.6929 18.2223 18.7398 18.186 18.7773 18.1543C18.796 18.1386 18.812 18.1235 18.8262 18.1104C18.8333 18.1037 18.8406 18.0967 18.8467 18.0908C18.8496 18.088 18.8528 18.0856 18.8555 18.083L18.8613 18.0771C18.8623 18.0762 18.8629 18.0749 18.1514 17.373L18.8633 18.0752L19.5459 17.3818C20.1633 16.7559 21.1436 16.6097 21.9746 17.0703L24.8398 18.6582C26.1356 19.3764 26.3667 21.1003 25.4209 22.0596L23.29 24.2197V24.2207C22.8617 24.655 22.3952 24.9059 21.9199 24.9512C19.7216 25.1601 14.0586 24.9704 7.93457 18.7617C2.10352 12.8499 1.12496 7.86213 1.00293 5.67285C0.970022 5.08212 1.23739 4.48847 1.75 3.96875L4.10449 1.58105Z" stroke="currentColor" stroke-width="2"/>
                          </svg>
