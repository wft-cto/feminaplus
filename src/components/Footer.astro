---
import { Image } from "astro:assets";
import FooterServices from "./FooterServices.astro";

const locations = [
  {
    name: "FP44",
    address: "SCO 268, SECTOR 44-C, CHD ",
    phone: "0172 46228844",
    whatsapp: "+91 8725055006",
  },
  {
    name: "FP KHARAR",
    address: "SCO 55, SECTOR 125, NEW SUNNY ENCLAVE",
    whatsapp: "+91 9815931884",
  },
  {
    name: "FP LUXE",
    address: "SCO 164-165, SECTOR 9-C, CHD.",
    phone: " 0172 4024040",
    whatsapp: "+91 7973268966",
  },
  {
    name: "FP PKL",
    address: "SCO 386, SECTOR 8",
    phone: "0172-4025050",
    whatsapp: "+91 9815962884",
  },
  {
    name: "FP ZIRAKPUR",
    address: "Pooja Plazio above Gopal Sweets, Zirakpur",
    phone: "",
    whatsapp: "9872234488",
  },
];

const marqueText = [
  {
    name: "Your Path to Better Health",
  },
  {
    name: "Wellness for Women",
  },
  {
    name: "Shaping Women's Wellness",
  },
];
---

<footer class="w-full bg-black text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 md:py-[46px] !md:pt-10">
    <div
      class="flex flex-col md:flex-row md:gap-[40px] lg:gap-[218px]"
      style="background-image: url('https://assets.feminaplussalon.com/public/gen-health-bg.svg'); "
    >
      <!-- Top section -->

      <div class="flex flex-col">
        <div class="mb-4 text-center">
          <a href="/" class="inline-block">
            <Image
              src="https://assets.feminaplussalon.com/public/FP-logo.svg"
              alt="FP Logo"
              width={200}
              height={80}
              class="h-12 md:h-16 w-auto brightness-0 invert"
            />
          </a>
          <p class="font-anticdidone text-[30px] uppercase">Femina Plus</p>
        </div>
        <p
          class="text-gray-300 mx-auto md:mb-4 uppercase font-anticdidone text-[24px] text-center w-[290px] md:w-[340px]"
        >
          hair | Beauty | Makeup | Hair wigs | Extensions
        </p>

        <!-- Quick Services Links -->
        <nav class="mb-6 mt-4" aria-label="Quick services">
          <ul class="flex flex-wrap justify-center gap-3 md:gap-4 text-sm">
            <li>
              <a
                href="/makeup"
                class="text-gray-300 hover:text-white transition-colors"
                >Makeup</a
              >
            </li>
            <li>
              <a
                href="/hair-patch-wigs"
                class="text-gray-300 hover:text-white transition-colors"
                >Hair Patches</a
              >
            </li>
            <li>
              <a
                href="/services/hair-spa"
                class="text-gray-300 hover:text-white transition-colors"
                >Hair SPA</a
              >
            </li>
            <li>
              <a
                href="/services/facials"
                class="text-gray-300 hover:text-white transition-colors"
                >Facials</a
              >
            </li>
            <li>
              <a
                href="/services"
                class="text-gray-300 hover:text-white transition-colors"
                >More Services</a
              >
            </li>
          </ul>
        </nav>

        <div class="flex relative gap-4 items-center justify-center my-[20px]">
          <a
            target="_blank"
            href="https://www.facebook.com/feminaplus.fp/"
            class="text-gray-300 group hover:bg-white border py-3 px-[18px] border-[#2c2c2c] rounded-full hover:text-white transition"
          >
            <svg
              class="w-[13px] h-[13px] group-hover:fill-black transition"
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
              ></path>
            </svg>
          </a>
          <a
            href="https://www.instagram.com/feminaplus44/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-300 group hover:bg-white border py-3 px-[18px] rounded-full border-[#2c2c2c] hover:text-white transition"
          >
            <svg
              class="w-[13px] h-[13px] group-hover:fill-black transition"
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
              ></path>
            </svg>
          </a>
          <a
            href="#"
            class="text-gray-300 group hover:bg-white border py-3 px-[18px] rounded-full border-[#2c2c2c] hover:text-white transition"
          >
            <svg
              class="w-[13px] h-[13px] group-hover:fill-black transition"
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
              ></path>
            </svg>
          </a>
          <a
            href="#"
            class="text-gray-300 group hover:bg-white border py-3 px-[18px] rounded-full border-[#2c2c2c] hover:text-white transition"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-[13px] h-[13px] transition group-hover:fill-black"
              viewBox="0 0 13 14"
              fill="currentColor"
            >
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M4.57764e-05 0.188477H3.76997L12.7422 13.006H8.97232L4.57764e-05 0.188477ZM1.82361 1.13792L9.46665 12.0566H10.9187L3.27564 1.13792H1.82361Z"
              ></path>
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M0.429688 12.5802L11.111 0L11.8347 0.614511L1.15345 13.1947L0.429688 12.5802Z"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Locations grid -->
      <div class="flex flex-col">
        <p class="font-manrope text-[22px] font-bold pb-6 text-white">
          Get in Touch
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
          {
            locations.map((location) => (
              <div class="flex items-center justify-start  gap-[24px]">
                <div class="flex items-start gap-2 mb-2">
                  <svg
                    width="40"
                    height="48"
                    viewBox="0 0 40 48"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M35.3929 20.4737H33.1867C30.6772 20.4737 28.6429 18.4393 28.6429 15.9298L28.6277 16.1435C28.4552 18.5829 26.4259 20.4737 23.9804 20.4737H23.8653C21.3558 20.4737 19.3214 18.4393 19.3214 15.9298L18.9402 17.2772C18.4051 19.1682 16.679 20.4737 14.7138 20.4737C12.2879 20.4737 10.3214 18.5072 10.3214 16.0813V15.9298C9.75923 18.579 7.42027 20.4737 4.71209 20.4737H2.60714M35.3929 20.4737V30M35.3929 20.4737C36.2805 20.4737 37 19.7541 37 18.8665V12.8053L30.25 1H8.07143L1 12.8053V18.8665C1 19.7541 1.71954 20.4737 2.60714 20.4737M2.60714 20.4737V34.4298M2.60714 34.4298V38H28M2.60714 34.4298H27.5"
                      stroke="white"
                      stroke-width="2"
                    />
                    <path
                      d="M33.5 29.5C36.8137 29.5 39.5 32.1863 39.5 35.5C39.5 36.2955 39.188 37.4189 38.6621 38.6992C38.1422 39.9649 37.4359 41.3314 36.6943 42.5928C35.9526 43.8544 35.1831 44.9994 34.543 45.8232C34.2217 46.2367 33.9413 46.5581 33.7197 46.7715C33.6299 46.858 33.5559 46.918 33.5 46.959C33.4441 46.918 33.3701 46.858 33.2803 46.7715C33.0587 46.5581 32.7783 46.2367 32.457 45.8232C31.8169 44.9994 31.0474 43.8544 30.3057 42.5928C29.5641 41.3314 28.8578 39.9649 28.3379 38.6992C27.812 37.4189 27.5 36.2955 27.5 35.5C27.5 32.1863 30.1863 29.5 33.5 29.5Z"
                      stroke="white"
                    />
                    <circle cx="33.5" cy="35.5" r="2.5" fill="white" />
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold text-white mb-1">{location.name}</h3>
                  <p class="text-sm text-gray-300 mb-1">{location.address}</p>
                  <p class="text-sm text-gray-300">
                    {location.phone && (
                      <a
                        href={`tel:${location.phone.replace(/\s+/g, "")}`}
                        class="hover:underline"
                      >
                        {location.phone}
                      </a>
                    )}
                    {location.phone && location.whatsapp && <span>, </span>}
                    {location.whatsapp && (
                      <a
                        href={`tel:${location.whatsapp.replace(/\s+/g, "").replace("+", "")}`}
                        class="hover:underline"
                      >
                        {location.whatsapp}
                      </a>
                    )}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
    <!-- Bottom section -->
  </div>
  <FooterServices />
  <div class="border-t border-[#d3d3d359] pt-8">
    <div
      class="flex max-w-7xl mx-auto px-2 flex-col md:flex-row justify-between items-center gap-4 mb-6"
    >
      <p class="text-sm text-gray-300 text-center md:text-start">
        Copyright 2026 Femina Plus. All rights reserved.
      </p>
      <div class="flex gap-2">
        <a href="#" class="grayscale transition"
          ><img
            src={`https://assets.feminaplussalon.com/public/visa.svg`}
            alt=`visa`
          /></a
        >
        <a href="#" class="grayscale transition"
          ><img
            src={`https://assets.feminaplussalon.com/public/mastercard.svg`}
            alt=`mastercard`
          /></a
        >
        <a href="#" class="grayscale transition"
          ><img
            src={`https://assets.feminaplussalon.com/public/rupay.png`}
            alt=`rupay`
          /></a
        >
      </div>
    </div>

    <!-- Footer taglines -->
  </div>
  <marquee
    class="border border-[#d3d3d359] py-1 md:pt-9 md:pb-8 border-r-0 border-l-0"
    direction="left"
  >
    <div class="flex gap-16">
      {
        marqueText.map((marquee) => (
          <div class="flex gap-5">
            <img
              src={`https://assets.feminaplussalon.com/public/white-logo-marquee.svg`}
              alt="marquee"
            />
            <p class="text-[34px] ml-[5px] font-anticdidone">{marquee.name}</p>
          </div>
        ))
      }
    </div>
  </marquee>
</footer>
