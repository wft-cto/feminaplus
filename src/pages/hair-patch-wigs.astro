---
import Header from "../components/Header.astro";
import HeroWithBooking from "../components/HeroWithBooking.astro";
import HairPatchWigsServices from "../components/HairPatchWigsServices.astro";
import BeforeAfterGallery from "../components/BeforeAfterGallery.astro";
import EmpoweringWomen from "../components/EmpoweringWomen.astro";
import NextGenHealth from "../components/NextGenHealth.astro";
import Promotional from "../components/Promotional.astro";
import Rating from "../components/rating.astro";
import BrandLogos from "../components/BrandLogos.astro";
import Locations from "../components/Locations.astro";
import Testimonials from "../components/Testimonials.astro";
import BookingForm from "../components/BookingForm.astro";
import InstagramFeed from "../components/InstagramFeed.astro";
import Footer from "../components/Footer.astro";
import GMT from '../components/GMT.astro';
import YoutubeVideos from "../components/YoutubeVideos.astro";

const hairPatchWigImages = [
  {
    id: "1",
    beforeImage: "/hairPatch/bald_image_first.jpeg",
    afterImage: "/hairPatch/transformed_image_first.jpeg",
    service: "Full Wig Installation",
    clientName: "Client 1"
  },
  {
    id: "2",
    beforeImage: "/hairPatch/bald_image_second.jpeg",
    afterImage: "/hairPatch/reformed_image_second.jpeg",
    service: "Hair Patch Installation",
    clientName: "Client 2"
  },
  {
    id: "3",
    beforeImage: "/hairPatch/bald_image_third.jpeg",
    afterImage: "/hairPatch/transformed_image_third.jpeg",
    service: "Lace Front Wig",
    clientName: "Client 3"
  },
  {
    id: "4",
   beforeImage: "/hairPatch/bald_image_forth.jpeg",
   afterImage: "/hairPatch/transformed_image_forth.jpeg",
    service: "Hair Topper",
    clientName: "Client 4"
  },
  {
    id: "5",
    beforeImage: "/hairPatch/bald_image_fifth.jpeg",
    afterImage: "/hairPatch/transformed_image_fifth.jpeg",
    service: "Wig Restyling",
    clientName: "Client 5"
  },
  {
    id: "6",
    beforeImage: "/hairPatch/bald_image_sixth.jpeg",
    afterImage: "/hairPatch/transformed_image_sixth.jpeg",
    service: "Custom Wig Design",
    clientName: "Client 6"
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Femina Plus - Expert Hair Patches & Wigs. Professional Wig Installation | Hair Patches | Custom Wig Design"
    />
    <title>Femina Plus - Beauty & Wellness Center | Hair Patches & Wigs</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js" is:inline
    ></script>
      <GMT /> 
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" />

    <link
      rel="stylesheet"
      type="text/css"
      href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css"
    />

    <script
      src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"
      is:inline></script>
  </head>
  <body class="antialiased">
      <GMT /> 
    <Header  class="mb-4"/>
    <main class="mt-4">
      <HeroWithBooking 
        title="To our Hair Patch & Wigs Studio"
        subtitle="Professional Wig Installation | Hair Patches | Custom Designs"
        videoBackground="/videos/hair-patch.mp4"
        backgroundImage="/hero-section-image.jpg"
        filterSalons={["fp44"]}
      />
      <HairPatchWigsServices />
      <BeforeAfterGallery 
        title="Hair Patches & Wigs Gallery"
        subtitle="See the stunning transformations from our expert wig specialists"
        images={hairPatchWigImages}
      />
       <YoutubeVideos />
      <Locations filterLocations={["FP44"]} />
      <!-- <BookingForm /> -->
      <Testimonials />
      <InstagramFeed />
    </main>
    <Footer />
  </body>
</html>

<script
  is:inline
  type="text/javascript"
  src="//cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
<script src="../js/Global.js"></script>
<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
