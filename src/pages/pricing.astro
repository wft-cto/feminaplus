const faqs = [
  {
    question: "Are the prices the same at all Femina Plus locations?",
    answer: "Our pricing is standardized across all Femina Plus salon branches. However, certain premium services may have slight variations depending on the location and the senior stylist you choose. We recommend confirming the exact pricing with your preferred branch when booking your appointment."
  },
  {
    question: "Do you offer any packages or combo discounts?",
    answer: "Yes, Femina Plus offers special combo packages for bridal services, pre-wedding grooming, and regular maintenance packages. We also run seasonal promotions and first-time client offers. Ask at your nearest branch or message us on WhatsApp for current package deals and discounts."
  },
  {
    question: "What payment methods are accepted?",
    answer: "We accept cash, all major credit and debit cards, UPI payments (Google Pay, PhonePe, Paytm), and net banking. For bridal and premium packages, we also offer the option to pay in installments. Payment is collected at the salon after your service is completed."
  },
  {
    question: "Do prices include taxes?",
    answer: "The prices listed on our menu are base service prices. Applicable GST will be added to the final bill as per government regulations. Our staff will always inform you of the total amount including taxes before proceeding with any service."
  },
  {
    question: "What does 'onwards' mean in the pricing?",
    answer: "Services marked 'onwards' have a starting price that may vary depending on factors like hair length, hair density, product quantity required, and the complexity of the service. For example, hair color pricing depends on your hair length and the amount of product needed. Our stylists will give you an exact quote during your consultation."
  },
  {
    question: "Can I get a consultation before booking a service?",
    answer: "Absolutely! We offer free consultations for all our services. Whether you're considering a hair color change, a hair treatment, or bridal makeup, our experts will assess your needs, discuss options, and provide a detailed price estimate before you commit to any service."
  },
  {
    question: "Is there an extra charge for home or venue services?",
    answer: "Yes, on-location services such as bridal makeup at your home or wedding venue may include additional charges for travel and setup. The exact amount depends on the distance and the services booked. Contact us for a customized quote for on-location services."
  },
  {
    question: "How do I book an appointment?",
    answer: "You can book an appointment through our website using the booking form, call us directly at your nearest branch, or send us a WhatsApp message using the green button on any section of this page. We recommend booking at least a day in advance, and 2-4 weeks ahead for bridal services."
  },
];
---

<html lang="en">
  <head>
    <SEOHead
      title="Service Pricing & Menu"
      description="View the complete pricing menu for Femina Plus salon services including hair, makeup, facials, waxing, manicure, pedicure, and more. Transparent pricing with no hidden charges across all our branches."
      keywords="salon pricing, beauty service prices, hair cut price, bridal makeup cost, facial price, waxing rates, salon menu, Femina Plus pricing"
      canonical="https://feminaplussalon.com/pricing"
      ogImage="https://assets.feminaplussalon.com/public/hero_section_image_new.webp"
    />
    <LocalBusinessSchema />

    <script src="https://code.jquery.com/jquery-3.6.0.min.js" is:inline></script>
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" />
    <link
      rel="stylesheet"
      type="text/css"
      href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css"
    />
    <script
      src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"
      is:inline></script>
    <GMT />

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-TG9QGE938J"></script>
    <script>
      (window as any).dataLayer = (window as any).dataLayer || [];
      function gtag(...args: any[]) {
        (window as any).dataLayer.push(args);
      }
      gtag("js", new Date());
      gtag("config", "G-TG9QGE938J");
    </script>
  </head>
  <body class="antialiased">
    <GMT />
    <Header class="mb-4" services={services} />
    <main class="mt-4">
      <HeroWithBooking
        title="Our Pricing"
        subtitle="Hair · Beauty · Makeup · SPA · Academy"
        backgroundImage="https://assets.feminaplussalon.com/public/hero_section_image_new.webp"
        autoSelectFirst={false}
      />

      <PricingNav categories={categories} />

      {allSections.map(section => (
        <PricingSection {...section} />
      ))}

      <FAQ
        faqs={faqs}
        subtitle="Common questions about our pricing and services"
      />
      <Testimonials />
      <InstagramFeed />
      <Locations />
    </main>
    <Footer />
  </body>
</html>

<script
  is:inline
  type="text/javascript"
  src="//cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
<script src="../js/Global.js"></script>
<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
