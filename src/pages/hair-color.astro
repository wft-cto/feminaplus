---
import Header from "../components/Header.astro";
import HeroWithBooking from "../components/HeroWithBooking.astro";
import HairColorService from "../components/HairColorService.astro";
import Locations from "../components/Locations.astro";
import Testimonials from "../components/Testimonials.astro";
import BookingForm from "../components/BookingForm.astro";
import InstagramFeed from "../components/InstagramFeed.astro";
import Footer from "../components/Footer.astro";
import HairColorGallery from "../components/HairColor.astro";
import GMT from "../components/GMT.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Femina Plus - Expert Hair, Makeup & Nails. Your Hair | Makeup | Nails | Skin | Lashes"
    />
    <title>Femina Plus - Beauty & Wellness Center | Makeup</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js" is:inline
    ></script>
    <GMT />
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" />

    <link
      rel="stylesheet"
      type="text/css"
      href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css"
    />

    <script
      src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"
      is:inline></script>

    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=AW-17779239970"></script>

    <script>
      (window as any).dataLayer = (window as any).dataLayer || [];
      function gtag(...args: any[]) {
        (window as any).dataLayer.push(args);
      }
      gtag("js", new Date());

      gtag("config", "AW-17779239970");
    </script>
  </head>
  <body class="antialiased">
    <GMT />
    <Header class="mb-4" />
    <main class="mt-4">
      <HeroWithBooking
        title="To our Hair Color Studio"
        subtitle="Professional Hair color  Services"
        backgroundImage="/hair-color-hero.jpg"
        autoSelectFirst={false}
      />
      <HairColorService />
      <HairColorGallery
        title="hair color gallery"
        subtitle="see the stunning transformations from our expert hair color artists"
      />
      <!-- <BookingForm /> -->
      <Testimonials />
      <InstagramFeed />
      <Locations />
    </main>
    <Footer />
  </body>
</html>

<script
  is:inline
  type="text/javascript"
  src="//cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
<script src="../js/Global.js"></script>
<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
